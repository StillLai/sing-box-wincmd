# sing-box core and runtime files
service/core/

# WinSW service wrapper (downloaded at runtime)
service/sing-box-service.exe

# WinSW XML configs (modified at runtime by setServiceBootMode)
service/sing-box-service-mixed.xml
service/sing-box-service-tun.xml

# WinSW runtime logs (dual-service: mixed + tun)
service/sing-box-service-mixed.*.log
service/sing-box-service-tun.*.log

# User config (contains private Gist ID)
config.env

# Backup files
*.bak

# Windows temp files
*.tmp
Thumbs.db
Desktop.ini

# Editor files
.vscode/
*.swp
*.swo

# ThinCoder
.thincoder/